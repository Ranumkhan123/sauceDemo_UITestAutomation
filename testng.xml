<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="saucedemo_UITestAutomation">


    <test name="Test_1-Chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.tests.Tests1_SingleProductPurchase"/>
        </classes>
    </test>

    <test name="Test_2-Chrome">
        <parameter name="browser" value="chrome"/>
