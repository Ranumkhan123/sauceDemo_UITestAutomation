    <test name="Test_2-Edge">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.tests.Test2_MultipleProductsPurchase"/>
        </classes>
    </test>

    <test name="Test_1-FireFox">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.tests.Tests1_SingleProductPurchase"/>
        </classes>
    </test>

    <test name="Test_2-FireFox">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.tests.Test2_MultipleProductsPurchase"/>
        </classes>
    </test>

</suite>
