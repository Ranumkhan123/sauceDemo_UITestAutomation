<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="saucedemo_UITestAutomation">

    <listeners>
        <listener class-name="utils.ExtentTestNGListener"/>
    </listeners>


    <test name="Test_1-Chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.tests.Tests1_EndtoEndFlow_SingleProduct"/>
        </classes>
    </test>

    <test name="Test_2-Chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.tests.Tests2_EndtoEndFlow_MultipleProducts"/>
        </classes>
    </test>



    <test name="Test_1-Firefox">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.tests.Tests1_EndtoEndFlow_SingleProduct"/>
        </classes>
    </test>

    <test name="Test_2-Firefox">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.tests.Tests2_EndtoEndFlow_MultipleProducts"/>
        </classes>
    </test>



    <test name="Test_1-Edge">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.tests.Tests1_EndtoEndFlow_SingleProduct"/>
        </classes>
    </test>

    <test name="Test_2-Edge">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.tests.Tests2_EndtoEndFlow_MultipleProducts"/>
        </classes>
    </test>


</suite>
